# Server-side settings for /api/send-reminders (set these in Vercel > Project > Settings > Environment Variables).
# Never commit real values. The browser only uses the public URL and anon key in app/config.js.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM="Laveesho <hello@laveesho.com>"
ADMIN_EMAIL=business@laveesho.com
SITE_URL=https://laveesho.com
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Set to 1 to run the job without sending emails
DRY_RUN=
